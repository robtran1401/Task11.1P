#include <SPI.h>
#include <WiFiNINA.h>
#include "ThingSpeak.h"
#include "DHT.h"

// WIFI
char ssid[] = "WIFI_NAME";
char pass[] = "WIFI_PASSWORD";

// THINGSPEAK
unsigned long channelID = 3307064;
const char *writeAPIKey = "KN7RPR6K0KBV19B0";
WiFiClient client;

// Sensor pins
#define DHTPIN 2
#define DHTTYPE DHT11
#define LIGHT_PIN A0

DHT dht(DHTPIN, DHTTYPE);

// Timing
const unsigned long uploadInterval = 30000;
unsigned long lastUploadTime = 0;

// Sunlight logic
const int sunlightThreshold = 600;   // adjust after testing
bool inSunlight = false;
unsigned long sunlightStartTime = 0;
unsigned long totalSunlightTime = 0;

void connectToWiFi();
float readTemperature();
int readLightLevel();
void updateSunlightStatus(int lightLevel);
void printReadings(float temperature, int lightLevel);
void sendDataToThingSpeak(float temperature, int lightLevel);

void setup() {
  Serial.begin(9600);
  delay(1500);

  dht.begin();
  connectToWiFi();
  ThingSpeak.begin(client);

  Serial.println("Smart Terrarium Monitoring System started.");
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    connectToWiFi();
  }

  if (millis() - lastUploadTime >= uploadInterval) {
    float temperature = readTemperature();
    int lightLevel = readLightLevel();

    if (!isnan(temperature)) {
      updateSunlightStatus(lightLevel);
      printReadings(temperature, lightLevel);
      sendDataToThingSpeak(temperature, lightLevel);
    } else {
      Serial.println("Error: Failed to read from DHT sensor.");
    }

    lastUploadTime = millis();
  }
}

void connectToWiFi() {
  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    WiFi.begin(ssid, pass);
    delay(5000);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi connected.");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

float readTemperature() {
  return dht.readTemperature();
}

int readLightLevel() {
  return analogRead(LIGHT_PIN);
}

void updateSunlightStatus(int lightLevel) {
  if (lightLevel >= sunlightThreshold && !inSunlight) {
    inSunlight = true;
    sunlightStartTime = millis();
    Serial.println("Sunlight started.");
  }

  if (lightLevel < sunlightThreshold && inSunlight) {
    inSunlight = false;
    totalSunlightTime += millis() - sunlightStartTime;
    Serial.println("Sunlight stopped.");
  }
}

void printReadings(float temperature, int lightLevel) {
  unsigned long totalMinutes = totalSunlightTime / 60000;

  if (inSunlight) {
    totalMinutes += (millis() - sunlightStartTime) / 60000;
  }

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Light Level: ");
  Serial.println(lightLevel);

  Serial.print("Sunlight Status: ");
  Serial.println(inSunlight ? "In sunlight" : "Not in sunlight");

  Serial.print("Total Sunlight Today: ");
  Serial.print(totalMinutes);
  Serial.println(" minutes");
}

void sendDataToThingSpeak(float temperature, int lightLevel) {
  unsigned long totalMinutes = totalSunlightTime / 60000;

  if (inSunlight) {
    totalMinutes += (millis() - sunlightStartTime) / 60000;
  }

  ThingSpeak.setField(1, temperature);
  ThingSpeak.setField(2, lightLevel);
  ThingSpeak.setField(3, inSunlight ? 1 : 0);
  ThingSpeak.setField(4, totalMinutes);

  int responseCode = ThingSpeak.writeFields(channelID, writeAPIKey);

  if (responseCode == 200) {
    Serial.println("Data sent to ThingSpeak successfully.");
  } else {
    Serial.print("ThingSpeak update failed. HTTP error code: ");
    Serial.println(responseCode);
  }
}
